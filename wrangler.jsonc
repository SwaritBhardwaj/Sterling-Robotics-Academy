{
  "name": "academy",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Public setting, not a secret: the Cloudflare Access team that signs people in.
  // Kept here so every deploy from GitHub has it (deploys replace dashboard text variables).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "sterlingroboticsacademy.cloudflareaccess.com"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
